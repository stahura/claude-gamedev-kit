{
  "permissions": {
    "allow": [
      "Bash(git *)", "Bash(gh release *)", "Bash(gh repo view *)", "Bash(gh repo clone *)", "Bash(gh api repos/*)",
      "Bash(gh run *)", "Bash(gh pr view *)",
      "Bash(python *)", "Bash(python3 *)", "Bash(python3 tools/*)", "Bash(curl *)", "Bash(unzip *)", "Bash(sha256sum *)",
      "Bash(ls *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(grep *)", "Bash(find *)", "Bash(wc *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(rm *)", "Bash(sed *)", "Bash(date *)", "Bash(iconv *)",
      "Bash(od *)", "Bash(du *)", "Bash(cut *)", "Bash(sort *)", "Bash(uniq *)", "Bash(awk *)", "Bash(chmod *)",
      "Bash(printf *)", "Bash(sh tools/*)", "Bash(bash tools/*)", "Bash(tools/*)", "Bash(powershell.exe *)",
      "Bash(taskkill *)", "Bash(tasklist *)", "Bash(xvfb-run *)", "Bash(ffmpeg *)",
      "Bash(godot *)", "Bash(godot.exe *)", "Bash(godot_console *)", "Bash(godot_console.cmd *)",
      "Bash(godot_console.exe *)", "Bash(blender *)", "Bash(blender.exe *)",
      "PowerShell(git *)", "PowerShell(gh release *)", "PowerShell(python *)", "PowerShell(python3 *)",
      "PowerShell(powershell -NoProfile -File tools/*)", "PowerShell(Compress-Archive *)", "PowerShell(Expand-Archive *)",
      "PowerShell(Get-ChildItem *)", "PowerShell(Get-Content *)", "PowerShell(Copy-Item *)", "PowerShell(Move-Item *)",
      "PowerShell(New-Item *)", "PowerShell(Remove-Item *)", "PowerShell(Start-Process *)", "PowerShell(ffmpeg *)",
      "PowerShell(godot *)", "PowerShell(godot.exe *)", "PowerShell(godot_console *)", "PowerShell(godot_console.cmd *)",
      "PowerShell(godot_console.exe *)", "PowerShell(blender *)", "PowerShell(blender.exe *)",
      "Edit(**)", "Write(**)", "Read(**)"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push origin --delete*)",
      "Bash(gh repo delete*)", "Bash(gh release delete *)",
      "PowerShell(git push --force*)", "PowerShell(git push -f*)", "PowerShell(gh repo delete*)",
      "PowerShell(gh release delete *)",
      "Edit(.claude/run-state/**)"
    ]
  },
  "autoContinueAtUsageLimit": true,
  "hooks": {
    "Stop": [
      {"hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_guard.py\"", "timeout": 20}]}
    ],
    "SubagentStop": [
      {"matcher": "visual-reviewer",
       "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_stop.py\"", "timeout": 20}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
       "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_guard.py\"", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "*",
       "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/heartbeat.py\"", "timeout": 5}]}
    ],
    "PermissionRequest": [
      {"matcher": "*",
       "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/permission_log.py\"", "timeout": 10}]}
    ],
    "SessionStart": [
      {"matcher": "compact|startup|resume",
       "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"", "timeout": 10}]}
    ]
  }
}
